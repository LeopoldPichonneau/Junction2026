# Copy to .env (never committed) and fill in the values. Keys travel by private Discord message.

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=timeproof
DB_USER=timeproof
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 8000 locally, 8080 on the VPS (Hostinger's Traefik holds 80 and 443 there)
APP_PORT=8000
# VPS only: public HTTPS address served through Traefik
PUBLIC_HOST=

# true = no key needed, external calls return simulated data in the right format
USE_MOCK=true

# Nemotron (server provided, hosted at Verda)
VERDA_INFERENCE_KEY=
NEMOTRON_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
NEMOTRON_MODEL=nemotron-3.5-super-vl

# Images are sent inline to Nemotron (Verda failed on remote URLs); false = send the link
NEMOTRON_IMAGE_AS_DATA=true
# verda (default) or nvidia = backup key from build.nvidia.com (about 40 calls/min per key)
NEMOTRON_PROVIDER=verda
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_CALLS_PER_MINUTE=35

# Gemini (key from aistudio.google.com; copy a "Flash" model id from AI Studio)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=

# Cloudinary evidence cards (analysis/cloudinary_cards.py): the three keys, or CLOUDINARY_URL alone
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Server only: where data/ is mounted inside its container (already the default)
# DATA_DIR=/data

# Sent to the Wikimedia APIs (without it: HTTP 429)
WIKI_USER_AGENT=TimeProofBot/0.1 (https://hackjunction.com; Junction 2026 hackathon prototype)

# Live watcher (server/watch.py, triggered by the Hermes Agent scheduler on the VPS)
# Shared secret for POST /api/internal/...: generate with `openssl rand -hex 24`
INTERNAL_TOKEN=
# First run only: how many hours of Wikipedia RecentChanges to read back
WATCH_FIRST_HOURS=24
# Shown on the site next to "Last check" (the schedule itself lives in Hermes)
WATCH_INTERVAL_MIN=10
# Human review desk: at most this many dossiers per hour
REVIEWS_PER_HOUR=10

# Secret key for the anonymous account codes of the Accounts page (any long random string).
# Without it the codes change at each server restart. Generate one: openssl rand -hex 32
ACCOUNT_ID_KEY=
