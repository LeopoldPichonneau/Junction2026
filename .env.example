# Copy to .env (never committed) and fill in the values. Keys travel by private Discord message.

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=timeproof
DB_USER=timeproof
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 8000 locally, 80 on the VPS
APP_PORT=8000

# true = no key needed, external calls return simulated data in the right format
USE_MOCK=true

# Nemotron (server provided, hosted at Verda)
VERDA_INFERENCE_KEY=
NEMOTRON_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
NEMOTRON_MODEL=nemotron-3.5-super-vl

# Gemini (key from aistudio.google.com; copy a "Flash" model id from AI Studio)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=

# Sent to the Wikimedia APIs (without it: HTTP 429)
WIKI_USER_AGENT=TimeProofBot/0.1 (https://hackjunction.com; Junction 2026 hackathon prototype)
